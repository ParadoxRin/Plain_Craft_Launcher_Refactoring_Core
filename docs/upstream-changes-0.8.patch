+        var x = new byte[32]; var y = new byte[32];
+        Array.Copy(blob, 8, x, 0, 32); Array.Copy(blob, 40, y, 0, 32);
+        byte[]? d = null;
+        if (hasPrivate) { d = new byte[32]; Array.Copy(blob, 72, d, 0, 32); }
+        return new ECParameters { Curve = ECCurve.NamedCurves.nistP256, Q = new ECPoint { X = x, Y = y }, D = d };
+    }

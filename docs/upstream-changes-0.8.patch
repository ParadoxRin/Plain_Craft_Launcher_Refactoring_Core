+    // Retain the upstream CNG key blob and IEEE-P1363 signature format.
+    private static ECParameters ReadCngP256Key(string base64, bool hasPrivate) {
+        var blob = Convert.FromBase64String(base64);
+        if (blob.Length != (hasPrivate ? 104 : 72) || BitConverter.ToUInt32(blob, 0) != (hasPrivate ? 0x32534345u : 0x31534345u) || BitConverter.ToUInt32(blob, 4) != 32)

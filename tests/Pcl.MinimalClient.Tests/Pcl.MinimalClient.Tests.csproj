<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../examples/Pcl.MinimalClient/Pcl.MinimalClient.csproj" />
    <ProjectReference Include="../../src/Pcl.Client/Pcl.Client.csproj" Condition="'$(UsePclSdkPackages)' != 'true'" />
    <ProjectReference Include="../../src/Pcl.Contract/Pcl.Contract.csproj" Condition="'$(UsePclSdkPackages)' != 'true'" />
  </ItemGroup>
  <ItemGroup><Compile Include="../../src/SharedProtocol/PrivatePipePath.cs" Link="Transport/PrivatePipePath.cs" /></ItemGroup>
  <ItemGroup Condition="'$(UsePclSdkPackages)' == 'true'"><PackageReference Include="Pcl.Client" Version="$(PclSdkVersion)" /><PackageReference Include="Pcl.Contract" Version="$(PclSdkVersion)" /></ItemGroup>
</Project>

<Project>
  <PropertyGroup>
    <PclSdkVersion Condition="'$(PclSdkVersion)' == ''">0.42.1</PclSdkVersion>
    <Deterministic>true</Deterministic>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).cache/nuget</RestorePackagesPath>
  </PropertyGroup>
</Project>

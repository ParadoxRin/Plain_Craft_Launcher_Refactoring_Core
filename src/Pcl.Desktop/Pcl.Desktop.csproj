<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PCL-MacPort</AssemblyName>
    <Version>0.43.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../docs/windows-layout-baseline.json" LogicalName="windows-layout.json" />
    <EmbeddedResource Include="../../docs/data/PCL2完整功能矩阵.json" LogicalName="feature-matrix.json" />
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <ProjectReference Include="../Pcl.Client/Pcl.Client.csproj" Condition="'$(UsePclSdkPackages)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../artifacts/native/libpclwindow.dylib" Link="libpclwindow.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../../artifacts/native/libpclwindow.dylib')" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../artifacts/native/lwjgl-unsafe-agent-2.0.jar" Link="lwjgl-unsafe-agent-2.0.jar" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../../artifacts/native/lwjgl-unsafe-agent-2.0.jar')" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Pcl.Contract/Pcl.Contract.csproj" Condition="'$(UsePclSdkPackages)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Pcl.Desktop.Updates/Pcl.Desktop.Updates.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePclSdkPackages)' == 'true'">
    <PackageReference Include="Pcl.Client" Version="$(PclSdkVersion)" />
    <PackageReference Include="Pcl.Contract" Version="$(PclSdkVersion)" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../vendor/MeloongCore/Shared/MeloongCore.csproj" />
    <ProjectReference Include="../../vendor/PCLCS/PCLCS.csproj" />
    <ProjectReference Include="../Pcl.Legacy/Pcl.Legacy.vbproj" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="Compatibility/*.json" /></ItemGroup>
  <!-- Use a developer-owned local application identity only when explicitly present.
       The tracked default is empty; both resources keep the same runtime name. -->
  <PropertyGroup>
    <MicrosoftApplicationConfig Condition="'$(MicrosoftApplicationConfig)' == '' and Exists('$(MSBuildThisFileDirectory)../../.local/microsoft-application.json')">$(MSBuildThisFileDirectory)../../.local/microsoft-application.json</MicrosoftApplicationConfig>
    <MicrosoftApplicationConfig Condition="'$(MicrosoftApplicationConfig)' == ''">$(MSBuildThisFileDirectory)Authentication/microsoft-application.json</MicrosoftApplicationConfig>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(MicrosoftApplicationConfig)" LogicalName="Pcl.Core.Authentication.microsoft-application.json" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="Tomlyn" Version="2.10.1" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../Pcl.Contract/Pcl.Contract.csproj" /></ItemGroup>
  <ItemGroup><Compile Include="../SharedProtocol/NdjsonFrames.cs" Link="Adapters/Protocol/NdjsonFrames.cs" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../Pcl.Domain/Pcl.Domain.csproj" /><ProjectReference Include="../Pcl.Ports/Pcl.Ports.csproj" /></ItemGroup>
  <ItemGroup>
    <Compile Include="../SharedProtocol/PrivatePipePath.cs" Link="Protocol/PrivatePipePath.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Adapters/Compatibility/Java/*.class" />
  </ItemGroup>
</Project>
